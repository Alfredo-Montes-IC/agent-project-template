Thumbs.db

# Local worktrees must never be nested into source commits.
.worktrees/

# Agent-local credentials, preferences, caches, and private memories.
.claude/settings.local.json
CLAUDE.local.md
.gemini/.env
.agents/.local/

# Local draft produced by the PR description skill.
PR_DESCRIPTION.md
