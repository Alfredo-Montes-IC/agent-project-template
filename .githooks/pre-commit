#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  python3 scripts/git_guard.py commit
  python3 scripts/review_gate.py check
  exec python3 scripts/project_checks.py --staged
elif command -v python >/dev/null 2>&1; then
  python scripts/git_guard.py commit
  python scripts/review_gate.py check
  exec python scripts/project_checks.py --staged
elif command -v py >/dev/null 2>&1; then
  py -3 scripts/git_guard.py commit
  py -3 scripts/review_gate.py check
  exec py -3 scripts/project_checks.py --staged
fi
printf '%s\n' 'Python 3 is required; commit blocked.' >&2
exit 1
