#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 scripts/git_guard.py push
elif command -v python >/dev/null 2>&1; then
  exec python scripts/git_guard.py push
elif command -v py >/dev/null 2>&1; then
  exec py -3 scripts/git_guard.py push
fi
printf '%s\n' 'Python 3 is required; push blocked.' >&2
exit 1
